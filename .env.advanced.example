# Optional backend overrides. Do NOT replace your apps/server/.env with this file.
# Copy only the settings you need into apps/server/.env or deployment variables.
# This file is documentation; the application does not load it automatically.

# Deployment. Local development normally needs none of these overrides.
NODE_ENV="development"
HOST="127.0.0.1"
PORT="3000"
PUBLIC_API_BASE_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
# false or explicitly trusted proxy IP/CIDR entries; never bare true or *.
TRUST_PROXY="false"

# GPT compatibility and request budgets.
GPT_API_STYLE="chat_completions"
GPT_STRUCTURED_OUTPUT="json_schema"
GPT_TIMEOUT_MS="12000"
GPT_MAX_OUTPUT_TOKENS="600"
GPT_MAX_RETRIES="0"
# Only string X-* headers and numeric temperature/top_p are supported.
GPT_HEADERS_JSON="{}"
GPT_EXTRA_BODY_JSON="{}"

# Independent speech capabilities. One Deepgram key serves both.
STT_PROVIDER="deepgram"
TTS_PROVIDER="deepgram"
DEEPGRAM_STT_MODEL="nova-3"
DEEPGRAM_STT_LANGUAGE="zh-CN"

# Audio tools and per-capability timeouts. Recording upload requires FFmpeg.
FFMPEG_PATH="ffmpeg"
STT_TIMEOUT_MS="8000"
TTS_TIMEOUT_MS="10000"

# Local is the default. Change to r2 only after configuring all R2 fields.
MEDIA_STORE="local"
MEDIA_LOCAL_DIR="./data/media"
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Request frequency limits: development defaults to false; production/test default to true.
# Disables only the session-creation and input per-minute quotas, not concurrency/capacity bounds.
RATE_LIMIT_ENABLED="false"

# Capacity, expiry and fault budgets. Per-minute values apply only when RATE_LIMIT_ENABLED=true.
# 0 keeps the session until an explicit restart or process shutdown; positive seconds opt into expiry.
SESSION_TTL_SECONDS="0"
MAX_SESSIONS="100"
MAX_ACTIVE_TURNS="8"
MAX_TURNS_PER_SESSION="24"
MAX_INPUTS_PER_MINUTE="12"
MAX_SESSIONS_PER_MINUTE="10"
HEARTBEAT_INTERVAL_MS="10000"
MEDIA_TTL_SECONDS="600"
MAX_MEDIA_BYTES="67108864"
MAX_AUDIO_BYTES="4194304"
FIRST_AUDIO_TIMEOUT_MS="20000"
NEXT_SEGMENT_TIMEOUT_MS="20000"
TURN_MAX_LIFETIME_MS="120000"
MAX_RECORDING_SECONDS="15"
MAX_UPLOAD_BYTES="4194304"

# Offline estimate for retained history only; not the provider total context window.
CONTEXT_HISTORY_TOKENS="1800"

# Direct ComfyUI image sharing, enabled only by APP_MODE=live + IMAGE_PROVIDER=comfyui.
IMAGE_PROVIDER="disabled"
COMFYUI_BASE_URL=""
COMFYUI_HEADERS_JSON='{}'
COMFYUI_OUTPUT="view"
COMFYUI_CHECKPOINT="oneObsession_v24.safetensors"
# SaveImageS3 requires an explicit HTTPS object origin (no credentials shared with it).
COMFYUI_S3_ORIGIN=""
IMAGE_JOB_TIMEOUT_MS="900000"
IMAGE_REQUEST_TIMEOUT_MS="15000"
IMAGE_POLL_MS="3000"
IMAGE_LONG_WAIT_MS="30000"
IMAGE_ASSET_TTL_SECONDS="1800"
IMAGE_MAX_ACTIVE="1"
IMAGE_MAX_QUEUED="8"
MAX_IMAGE_BYTES="12582912"
MOCK_IMAGE_DELAY_MS="6000"
MOCK_IMAGE_FAILURE="none"
