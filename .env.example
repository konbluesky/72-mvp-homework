# Backend only: apps/server/.env. Never put these values in VITE_*.
# mock runs without keys. Live voice/text uses GPT plus one Deepgram key for STT and TTS.
APP_MODE="mock"

# GPT Provider: API root URL (for example https://provider.example/v1), key, model.
# All LLM planning and repair calls run through LangGraph.
GPT_BASE_URL=""
GPT_API_KEY=""
GPT_MODEL=""

# Shared official Deepgram API key: recognition (STT) and synthesis (TTS).
# Select an actual flux-*-zh voice from your account; no voice is assumed available.
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL=""
# DEEPGRAM_MODEL is the TTS voice; preserve your existing voice selection.
# Optional STT defaults, verified against the official language catalog:
# DEEPGRAM_STT_MODEL="nova-3"
# DEEPGRAM_STT_LANGUAGE="zh-CN"
# STT_PROVIDER="disabled"  # Explicitly opt out of recording input.

# Optional: uncomment only if your GPT Provider needs a different API strategy.
# GPT_API_STYLE="chat_completions"
# GPT_STRUCTURED_OUTPUT="json_schema"

# Local media, ports, timeouts and safeguards already have application defaults.
# Deployment/R2/tuning overrides: .env.advanced.example (not loaded automatically).
