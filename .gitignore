# Only the runnable project and maintained documentation enter version control.
# Research/design files and generated evidence remain available locally.
/*
!/.dockerignore
!/.github/
!/.gitattributes
!/.gitignore
!/.npmrc
!/.nvmrc
!/.prettierignore
!/.prettierrc.json
!/.vscode/
!/AGENTS.md
!/AI_USAGE.md
!/README.md
!/apps/
!/assets/
!/compose.yaml
!/docs/
!/eslint.config.js
!/infra/
!/package.json
!/package-lock.json
!/packages/
!/playwright.config.ts
!/scripts/
!/tests/
!/tsconfig.base.json
!/tsconfig.tools.json
!/vitest.config.ts

# Keep current implementation, configuration, deployment and acceptance summaries.
/docs/*
!/docs/README.md
!/docs/provider-configuration.md
!/docs/architecture/
!/docs/contracts/
!/docs/development/
!/docs/operations/
!/docs/acceptance/
/docs/architecture/*
!/docs/architecture/decisions.md
!/docs/architecture/providers.md
/docs/contracts/*
!/docs/contracts/README.md
!/docs/contracts/openapi.json
/docs/development/*
!/docs/development/README.md
!/docs/development/vscode.md
!/docs/development/version-control.md
/docs/operations/*
!/docs/operations/README.md
!/docs/operations/nginx-production.conf
/docs/acceptance/*
!/docs/acceptance/implementation-plan.md
!/docs/acceptance/live2d-migration.md
!/docs/acceptance/deepgram-integration.md
!/docs/acceptance/character-expressiveness.md
!/docs/acceptance/demo.md

# Credentials, backups, private media and generated outputs at any depth.
.env
.env.*
!/.env.example
!/.env.frontend.example
!/.env.advanced.example
.dev.vars
.dev.vars.*
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.vite/
**/.vitest-cache/
**/playwright-report/
**/test-results/
**/data/
**/outputs/
**/tmp/
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo
*.map
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*.pem
*.key
*.p12
*.pfx
