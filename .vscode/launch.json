{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "角色互动平台: 前后端服务",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "node",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development",
        "HOST": "127.0.0.1",
        "PORT": "${config:mira.apiPort}",
        "PUBLIC_API_BASE_URL": "http://localhost:${config:mira.apiPort}",
        "API_PROXY_TARGET": "http://127.0.0.1:${config:mira.apiPort}",
        "CORS_ALLOWED_ORIGINS": "http://localhost:${config:mira.webPort},http://127.0.0.1:${config:mira.webPort}",
        "VITE_API_BASE_URL": "",
        "LANGSMITH_TRACING": "false",
        "WEB_PORT": "${config:mira.webPort}"
      },
      "presentation": {
        "hidden": true
      },
      "program": "${workspaceFolder}/scripts/project.mjs",
      "args": ["dev"]
    },
    {
      "name": "角色互动平台: 浏览器",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:${config:mira.webPort}",
      "webRoot": "${workspaceFolder}/apps/web",
      "preLaunchTask": "角色互动平台: 等待就绪",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "角色互动平台: 一键启动前后端",
      "configurations": ["角色互动平台: 前后端服务", "角色互动平台: 浏览器"],
      "preLaunchTask": "角色互动平台: 启动预检",
      "stopAll": true
    }
  ]
}
