    "@fastify/swagger": "9.9.2",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.5.3",
    "@langchain/openai": "1.8.0",
    "@mira/protocol": "0.1.0",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "inkjs": "2.4.0",
    "zod": "4.6.7"
