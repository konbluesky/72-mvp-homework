  "directorNotes": [
    {
      "requires": ["letter_reflected"],
      "text": "她已经读过信，也谈过自己的感受。可自然问用户今晚接下来想怎么过，推荐一句明确的共同决定和一句继续陪伴。用户仍可转移话题，不强推结局。",
      "replyActions": ["choose-depart", "choose-stay"],
      "chatReplies": ["我想再听听你的想法，不急着决定。"]
    },
    {
      "requires": ["letter_read"],
      "text": "信件已实际公开，可以顺着用户谈她的感受。若用户不知道怎么接话，轻轻问一句是否愿意听她说；不重复读信，也不催促结局。",
      "replyActions": ["talk-letter-reflection", "talk-companionship"],
      "chatReplies": ["慢慢说，我陪着你。"]
    },
    {
      "locations": ["counter"],
      "text": "这里只能知道署名和信封外观，纸张正文尚未公开。不编造内容；可自然提到这封信写着自己的名字，询问用户是否愿意陪自己看看。用户明确同意后才能打开。",
      "replyActions": ["inspect-letter", "move-window-seat"],
      "chatReplies": ["先不打开，我们聊点别的吧。"]
    },
    {
      "requires": ["companionship"],
      "text": "她已经接受陪伴。自然邀请继续坐坐或去吧台，不要求用户学习地点菜单；明确的决定可以来自会话。",
      "replyActions": ["move-counter"],
      "chatReplies": ["说说你最难忘的一次旅行吧。"]
    },
    {
      "locations": ["photo-corridor"],
      "text": "顺着对话提到墙上可见的海报，邀请一起看看；正文公开前不要提前讲出其中内容。",
      "replyActions": ["inspect-exhibition", "move-counter"],
      "chatReplies": ["先不看海报，陪你聊一会儿。"]
    },
    {
      "requires": ["photo_seen"],
      "locations": ["window-seat", "lobby", "washroom"],
      "text": "照片已经展示过。可以问用户这片海让他想到什么，或者接受陪伴、邀请换个地方聊；不反复要求看同一张照片。",
      "replyActions": ["talk-companionship", "move-counter"],
      "chatReplies": ["这片海让你想起了什么？"]
    },
    {
      "requires": ["waiting_heard"],
      "locations": ["window-seat", "lobby", "washroom"],
      "text": "用户已经听过她在等谁。顺着感受交流，可邀请看照片或继续陪伴，不再次要求用户询问等谁。",
      "replyActions": ["view-photo", "talk-companionship"],
      "chatReplies": ["如果不想细说，我们就聊点轻松的吧。"]
    },
    {
      "locations": ["window-seat"],
      "text": "以摄影、等候和陪伴自然交流。若用户不知怎么接话，可以问是否想看照片，或者愿不愿再坐一会儿；不把全部动作清单念给用户。",
      "replyActions": ["view-photo", "talk-companionship"],
      "chatReplies": ["先不看照片，你最近过得怎么样？"]
    },
    {
      "text": "这是一次与角色持续交流的相遇。开场留一个容易回答的问题，顺着用户自然接话，用身边的事物邀请下一句，不要求用户先选模式或找热点。用户拒绝、想停留或转移话题时尊重，不编造未公开信息。",
      "replyActions": ["talk-waiting"],
      "chatReplies": ["你最难忘的一次旅行去了哪里？"]
    }
  ],
  "entries": {
    "story": "story_start",
    "conversation": "conversation_start"
  },
  "actionDescriptions": {
    "view-photo": "实际拿出并展示那张海岸照片。用户直接请求看照片（包括“能看看照片吗”这样的礼貌问句）就可执行；仅询问照片的故事或拒绝查看时不执行。无需再问一遍是否想看。",
    "talk-waiting": "用户明确想听她在等谁时，说出等候旧友的简短回应。普通关于朋友的闲聊不必触发。",
    "talk-companionship": "用户明确愿意陪她坐会儿时，接受陪伴；不读信也可以慢慢讨论今晚的选择。"
  },
  "openingVoice": "hello",
