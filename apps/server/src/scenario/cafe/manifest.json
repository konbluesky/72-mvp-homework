  "entry": "menu",
  "voices": {
    "hello": {
      "text": "雨还在下。你也想在这里躲一会儿吗？",
      "file": "hello.wav",
      "emotion": "curious",
      "action": "acknowledge"
    },
    "helloNext": {
      "text": "我叫米拉。窗边的位置，留给你。",
      "file": "helloNext.wav",
      "emotion": "curious",
      "action": "none"
    },
    "waiting": {
      "text": "我在等一个很久没见的人。也许，她今天不会来了。",
      "file": "waiting.wav",
      "emotion": "guarded",
      "action": "lookWindow"
    },
    "travel": {
      "text": "你也喜欢旅行吗？我一直记得海边的那阵风。",
      "file": "travel.wav",
      "emotion": "curious",
      "action": "none"
    },
    "comfort": {
      "text": "谢谢你。有人愿意陪我坐一会儿，已经很好了。",
      "file": "comfort.wav",
      "emotion": "relieved",
      "action": "none"
    },
    "photo": {
      "text": "可以。这是我们在海边留下的照片，你看，天空很亮。",
      "file": "photo.wav",
      "emotion": "relieved",
      "action": "offerPhoto"
    },
    "rain": {
      "text": "雨好像小了一点。今晚，也没有刚才那么冷了。",
      "file": "rain.wav",
      "emotion": "curious",
      "action": "none"
    },
    "refuse": {
      "text": "好，我们不看照片。就听一会儿雨声吧。",
      "file": "refuse.wav",
      "emotion": "curious",
      "action": "none"
    },
    "after": {
      "text": "刚才那张照片，让我想起了很多温暖的事。",
      "file": "after.wav",
      "emotion": "curious",
      "action": "none"
    },
    "storyDepart": {
      "text": "好。这次，我想自己选下一站。",
      "file": "storyDepart.wav",
      "emotion": "relieved",
      "action": "none"
    },
    "storyLetter": {
      "text": "有些话，可以慢慢说。我想先给她留下回信。",
      "file": "storyLetter.wav",
      "emotion": "relieved",
      "action": "none"
    },
    "storyStay": {
      "text": "好。今晚，我们不急着回答所有问题。",
      "file": "storyStay.wav",
      "emotion": "relieved",
      "action": "none"
    },
    "letterKnown": {
      "text": "原来，阿岚下午来过。她给我的照片留了一面墙，我想重新和她联系。",
      "file": "letterKnown.wav",
      "emotion": "relieved",
      "action": "focusProp"
    },
    "letterUnknown": {
      "text": "我在等阿岚。但她今天来没来过，我还不确定。",
      "file": "letterUnknown.wav",
      "emotion": "curious",
      "action": "none"
    },
    "gallery": {
      "text": "那是我们一起办过的摄影展。后来，各自去了不同的地方。",
      "file": "gallery.wav",
      "emotion": "curious",
      "action": "none"
    },
    "washroomPause": {
      "text": "我带来了照片，却一直没有想好，重新联系她的第一句话。",
      "file": "washroomPause.wav",
      "emotion": "curious",
      "action": "none"
    },
    "lastNight": {
      "text": "今晚是旧店最后一晚营业。明天，这些桌椅就要搬走了。",
      "file": "lastNight.wav",
      "emotion": "curious",
      "action": "none"
    },
    "storyReadLetter": {
      "text": "这封信，写着我的名字。你陪我一起看看吧。",
      "file": "storyReadLetter.wav",
      "emotion": "relieved",
      "action": "focusProp"
    }
  },
